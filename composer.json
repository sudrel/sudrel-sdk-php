{
    "name": "integrobr/nfse-sdk",
    "description": "Cliente oficial PHP para a API pública do IntegroBR NFS-e Recebidas",
    "type": "library",
    "license": "MIT",
    "homepage": "https://recebidas.integrobr.com/docs",
    "authors": [
        {
            "name": "IntegroBR",
            "email": "comercial@integrobr.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "IntegroBR\\NfseSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntegroBR\\NfseSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
